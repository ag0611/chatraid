# --- Twitch (create an app at https://dev.twitch.tv/console) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8000/auth/twitch/callback
TWITCH_CHANNEL=your_channel_name
# Optional: lets the bot SEND chat replies (otherwise it only reads chat). Token needs chat:edit.
TWITCH_BOT_NICK=
TWITCH_BOT_TOKEN=oauth:xxxxxxxx
TWITCH_EVENTSUB_SECRET=change-me

# --- AI Director (optional; without a key the template fallback runs) ---
OPENAI_API_KEY=
CHATRAID_DIRECTOR_MODEL=gpt-4o-mini

# --- App ---
CHATRAID_ADMIN_TOKEN=pick-a-long-random-string
CHATRAID_SECRET_KEY=            # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CHATRAID_DB=chatraid.db
CHATRAID_THEME=fantasy          # fantasy | scifi | spooky
CHATRAID_DIRECTOR_INTERVAL=15   # seconds between events
CHATRAID_DEMO=0                 # 1 = auto-start a session with simulated chat (no Twitch needed)
